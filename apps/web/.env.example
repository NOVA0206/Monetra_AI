# Environment Variables
# Copy this file to .env and fill in the values

# Ethereum address to receive payments (required)
PAYMENT_RECEIVER_ADDRESS=

# Private key for signing receipts (required) [secret]
PAYMENT_PRIVATE_KEY=

# Deployed ERC20 token address
NEXT_PUBLIC_TOKEN_ADDRESS=

# Private key for deployment and transactions (required) [secret]
PRIVATE_KEY=

# URL of the ERC20 deployment API
ERC20_DEPLOYMENT_API_URL=http://localhost:4000

# Name of the AI agent (required)
AGENT_NAME=MyAgent

# OpenRouter API key for LLM access (required) [secret]
OPENROUTER_API_KEY=

# Model to use via OpenRouter
OPENROUTER_MODEL=openai/gpt-4o

# ERC-8004 registry contract address
NEXT_PUBLIC_AGENT_REGISTRY_ADDRESS=

# Agent wallet private key for registry operations [secret]
AGENT_PRIVATE_KEY=

# Network for agent operations (arbitrum or arbitrum-sepolia) (required)
NEXT_PUBLIC_AGENT_NETWORK=arbitrum

# Arbitrum RPC URL for deployment (required)
STYLUS_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Private key for deployment (required) [secret]
DEPLOYER_PRIVATE_KEY=

# Dune Analytics API key for blockchain data queries (required) [secret]
DUNE_API_KEY=

# Bot token from @BotFather (required) [secret]
TELEGRAM_BOT_TOKEN=

# API key for OpenAI (required) [secret]
OPENAI_API_KEY=

# WalletConnect Cloud project ID for wallet connections (required)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Application name displayed in wallet dialogs
NEXT_PUBLIC_APP_NAME=My DApp

# Alchemy API key for RPC access (required)
NEXT_PUBLIC_ALCHEMY_API_KEY=

# Alchemy API key for fetching onchain activity (required)
ALCHEMY_API_KEY=

# Network for onchain activity (arbitrum or arbitrum-sepolia) (required)
NEXT_PUBLIC_ONCHAIN_NETWORK=arbitrum